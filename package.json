{
  "name": "noisium",
  "private": true,
  "version": "0.0.0",
  "description": "Create your own ambience.",
  "author": "sebilune",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev": "vite",
    "dev:pages": "bun run build && wrangler pages dev",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "build": "tsc -b && vite build",
    "deploy": "bun run build && wrangler pages deploy",
    "tauri:icon": "tauri icon icon.png",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "clsx": "^2.1.1",
    "lucide-svelte": "^1.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.3.0",
    "@typescript/native": "npm:typescript@7",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "~6",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  }
}
